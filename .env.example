# IDSPay Aadhaar Validation & Auto-Verification
IDSPAY_BASE_URL=https://javabackend.idspay.in/api/v1/prod
IDSPAY_CLIENT_ID=client_id
IDSPAY_CLIENT_SECRET=client_secret
IDSPAY_API_KEY=api_key
IDSPAY_API_ID=api_id
IDSPAY_TOKEN_ID=token_id
IDSPAY_AADHAAR_INITIATE_PATH=/srv2/validation/digilocker-digital-kyc
IDSPAY_AADHAAR_STATUS_PATH=/srv2/validation/digilocker-digital-kyc
IDSPAY_AADHAAR_OTP_PATH=/srv2/digital-kyc/aadhar/auto-verification

# Aadhaar OTP Provider Configuration ('idspay' | 'sandbox' | 'mock')
AADHAAR_OTP_PROVIDER=idspay
AADHAAR_OTP_TIMEOUT_MS=20000

SANDBOX_API_BASE_URL=https://api.sandbox.co.in
SANDBOX_API_VERSION=2.0
SANDBOX_AUTH_VERSION=1.0.0
SANDBOX_API_KEY=sandbox_key
SANDBOX_API_SECRET=sandbox_secret

WEBSITE_AUTH_SECRET=secret
